          "type": "date",
          "format": "yyyy-MM-dd HH:mm:ss||yyyy-MM-dd'T'HH:mm:ss||strict_date_optional_time||epoch_millis"
        },
        "signType": {
          "type": "integer"
        },
        "continuousDaysAfter": {
          "type": "integer"
        },
        "totalDaysAfter": {
          "type": "integer"
        },
        "createTime": {
          "type": "date",
          "format": "yyyy-MM-dd HH:mm:ss||yyyy-MM-dd'T'HH:mm:ss||strict_date_optional_time||epoch_millis"
        },
        "updateTime": {
          "type": "date",
          "format": "yyyy-MM-dd HH:mm:ss||yyyy-MM-dd'T'HH:mm:ss||strict_date_optional_time||epoch_millis"
        },
        "deleted": {
