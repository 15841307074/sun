{
  "index_patterns": [
    "ad_event_logs_*"
  ],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 3,
      "number_of_replicas": 1
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "from": {
          "type": "keyword"
        },
        "eventType": {
          "type": "keyword"
        },
        "timestamp": {
          "type": "date",
          "format": "yyyy-MM-dd HH:mm:ss||yyyy-MM-dd'T'HH:mm:ss||strict_date_optional_time||epoch_millis"
        },
        "storeId": {
          "type": "keyword"
        },
        "memberId": {
          "type": "keyword"
        },
        "businessId": {
          "type": "keyword"
        },
        "adId": {
          "type": "keyword"
        },
        "adName": {
          "type": "keyword"
        },
        "adInfoPosition": {
          "type": "integer"
        },
        "stayMs": {
          "type": "long"
        }
      }
    }
  },
  "_meta": {
    "description": "广告埋点事件月度滚动索引模板，匹配 ad_event_logs_yyyy-MM"
  }
}
