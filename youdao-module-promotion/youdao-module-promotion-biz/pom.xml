        <dependency>
            <groupId>com.htyoudao.cloud</groupId>
            <artifactId>youdao-common</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>com.htyoudao.cloud</groupId>
            <artifactId>youdao-spring-boot-starter-biz-data-permission</artifactId>
        </dependency>

