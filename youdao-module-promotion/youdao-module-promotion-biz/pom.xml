        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.htyoudao.cloud</groupId>
            <artifactId>youdao-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.htyoudao.cloud</groupId>
