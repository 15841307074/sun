<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.htyoudao.youdao.module.bpm.dal.mysql.definition.BpmBusinessCopyMapper">

    <insert id="batchInsertCopyFlag">
        INSERT INTO business_task_copy (id, proc_inst_id, copy_flag, copy_user_id)
        VALUES
        <foreach collection="list" item="entity" separator=",">
            <!-- 注意：确保 #{id} 是正确的参数（若 id 是 entity 的属性，需改为 #{entity.id}） -->
            (#{entity.id}, #{entity.procInstId}, 1, #{id})
        </foreach>
    </insert>




</mapper>