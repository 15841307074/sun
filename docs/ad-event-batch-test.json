  "字段说明": {
    "eventType": "事件类型：ad_exposure(曝光) / ad_click(点击) / ad_leave(离开)",
    "exposureList": "批量曝光列表，仅 ad_exposure 事件使用。每个元素包含 adId/adName/adInfoPosition",
    "adInfoPosition": "广告详细位置 1-14：1.首页弹屏 2.首页轮播图 3.首页底部banner 4.首页活动 5.点餐页弹屏 6.点餐页轮播图 7.点餐页全局轮播banner 8.结算页广告 9.订单详情页广告 10.订单列表页banner 11.开屏 12.浮窗 13.订单详情弹窗 14.点餐页分组轮播",
    "stayMs": "停留时长(毫秒)，仅 ad_leave 事件携带",
    "from": "来源：1=微信小程序，2=支付宝",
    "channel": "渠道，为空时服务端默认补 1000000002",
    "timestamp": "发生时间，为空时服务端默认补当前时间",
    "businessId": "项目ID，服务端从 BusinessContextHolder 自动获取"
  },

  "测试步骤": {
    "1_批量曝光写入": "发送示例1或示例2，等待30秒让BulkIngester刷新到ES",
    "2_查询验证": "调用 POST /admin-api/analysis/ad/overview 查看数据",
    "3_趋势验证": "调用 POST /admin-api/analysis/ad/trend 查看每日趋势",
    "4_按位置分组": "调用 POST /admin-api/analysis/ad/by-position 查看各位置数据",
    "5_按广告分组": "调用 POST /admin-api/analysis/ad/by-ad 查看各广告数据"
  }
